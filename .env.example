# Copy to .env and fill in. Never commit .env.

# --- Option A (default): Anthropic Claude ---------------------------------
HR_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Cheapest current model ($0.10 / $0.50 per 1M tokens), used for both the assistant and the judge.
HR_MODEL=claude-haiku-5-5
HR_JUDGE_MODEL=claude-haiku-5-5

# --- Option B: OpenRouter free models -------------------------------------
# HR_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# HR_MODEL=google/gemma-4-31b-it:free
# HR_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
# HR_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: freeze "today" so the demo matches the eval cases (the eval always uses 2026-11-16).
HR_TODAY=2026-11-16
# HR_LLM_CACHE=1
# HR_REFERRAL_MIN_SCORE=4.0
